#!/bin/bash

set -e

# Apex ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(apex-default-agent) ]] && apex-done ensure agent-setup-invitation; then
  apex-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Apex." \
    --exec apex menu summon setup.default.agent
fi
