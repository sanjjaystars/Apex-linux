# Single source of truth for APEX_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/apex.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-apex          (Hyprland session via uwsm)
#   /usr/share/apex/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/apex.conf is written by apex-dev-link and reset by
# apex-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/apex.conf ]; then
  . /etc/apex.conf
  : "${APEX_PATH:=/usr/share/apex}"
else
  APEX_PATH=/usr/share/apex
fi
export APEX_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/apex-* via the apex package — prepending
# /usr/share/apex/bin would just be noise.
if [ "$APEX_PATH" != /usr/share/apex ]; then
  case ":$PATH:" in
    *":${APEX_PATH%/}/bin:"*) ;;
    *) PATH="${APEX_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
