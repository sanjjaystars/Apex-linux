#!/bin/bash

# apex:summary=Launch a TUI or focus an existing terminal window for it
# apex:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.apex.$(basename "$1")"
fi

LAUNCH_COMMAND="apex-launch-tui $@"

exec apex-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
