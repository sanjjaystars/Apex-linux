#!/bin/bash

# apex:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# apex:group=remove
# apex:name=gaming xbox-controllers
# apex:requires-sudo=true

set -e

apex-pkg-drop xpadneo-dkms

sudo rm -f /etc/modprobe.d/blacklist-xpad.conf /etc/modules-load.d/xpadneo.conf

echo ""
echo "Xbox controller support removed. Reboot to fully unload xpadneo and restore xpad."
