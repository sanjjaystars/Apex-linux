#!/bin/bash

# apex:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  apex-brightness-keyboard-mute on
  apex-osd -i microphone-muted -m "Microphone muted"
else
  apex-brightness-keyboard-mute off
  apex-osd -i microphone -m "Microphone on"
fi
