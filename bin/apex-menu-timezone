#!/bin/bash

# apex:summary=Select and set the system timezone
# apex:group=menu
# apex:name=timezone

set -e

timezone=$(timedatectl list-timezones | apex-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
apex-shell -q apex.clock refresh
apex-notification-send "Timezone is now set to $timezone"
