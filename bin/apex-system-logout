#!/bin/bash

# apex:summary=Log out after closing application windows
# apex:examples=apex logout | apex system logout
# apex:aliases=apex logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

apex-osd -i logout -m "Logging out" -d 5000

# Now close all windows
apex-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
