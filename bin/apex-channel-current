#!/bin/bash

# apex:summary=Print the active Apex package channel

set -euo pipefail

# Dev is a linked source checkout: APEX_PATH points somewhere other than
# the package-backed install at /usr/share/apex. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $APEX_PATH != "/usr/share/apex" ]]; then
  echo dev
  exit 0
fi

# apex-dev / apex-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. apex / apex-settings come
# from either the stable or rc mirror, distinguished by apex-version-channel
# (which reports the mirror as its first token).
if pacman -Q apex-dev apex-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q apex apex-settings >/dev/null 2>&1; then
  channel=$(apex-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
