#!/bin/bash

# apex:summary=Launch the default coding agent with a prompt
# apex:args=[--inline] <prompt...>
# apex:examples=apex agent prompt "Review this project"

# Prompts live here rather than on `apex agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: apex agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec apex-agent "${inline[@]}" --prompt "$*"
