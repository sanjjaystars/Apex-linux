#!/bin/bash

# apex:summary=Launch or focus on a given web app identified by the window-pattern.
# apex:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: apex-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="apex-launch-webapp $@"

exec apex-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
