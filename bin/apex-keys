#!/bin/bash

# apex:group=keys
# apex:summary=Display the Apex Linux keybindings cheat sheet in terminal or interactive menu
# apex:args=[filter] [--menu|-m] [--raw|-r] [--help|-h]
# apex:examples=apex keys | apex keys workspace | apex keys --menu

set -eo pipefail

KEYS_FILE="$APEX_PATH/docs/KEYS.md"

usage() {
  cat <<'EOF'
Apex Linux Keybindings Cheat Sheet

Usage:
  apex keys [filter]          Display keybindings filtered by text (case-insensitive)
  apex keys --menu, -m        Launch interactive graphical search menu
  apex keys --raw, -r         Print the raw markdown keybindings reference
  apex keys --help, -h        Show this help message

Examples:
  apex keys
  apex keys window
  apex keys workspace
  apex keys audio
  apex keys --menu
EOF
}

show_menu() {
  if command -v apex-menu-keybindings >/dev/null 2>&1; then
    exec apex-menu-keybindings "$@"
  elif [[ -x "$APEX_PATH/bin/apex-menu-keybindings" ]]; then
    exec "$APEX_PATH/bin/apex-menu-keybindings" "$@"
  else
    echo "Error: apex-menu-keybindings not found." >&2
    exit 1
  fi
}

show_raw() {
  if [[ -f $KEYS_FILE ]]; then
    cat "$KEYS_FILE"
  else
    echo "Error: Keybindings file not found at $KEYS_FILE" >&2
    exit 1
  fi
}

display_cheat_sheet() {
  local filter="${1:-}"

  if [[ ! -f $KEYS_FILE ]]; then
    echo "Error: Keybindings file not found at $KEYS_FILE" >&2
    exit 1
  fi

  local output
  output=$(awk -F'|' -v filter="$filter" '
    BEGIN {
      filter_lower = tolower(filter)
      matched_section = 0
      section_title = ""
      has_rows = 0
    }
    /^## / {
      if (has_rows > 0) {
        # previous section had matching rows
      }
      section_title = substr($0, 4)
      has_rows = 0
      next
    }
    /^\| `.*` \|/ {
      chord = $2; gsub(/^ +| +$|`/, "", chord)
      action = $3; gsub(/^ +| +$/, "", action)
      desc = $4; gsub(/^ +| +$/, "", desc)

      row_text = tolower(chord " " action " " desc)

      if (filter_lower == "" || index(row_text, filter_lower) > 0 || index(tolower(section_title), filter_lower) > 0) {
        if (has_rows == 0) {
          printf "\n\033[1;36m== %s ==\033[0m\n", section_title
        }
        printf "  \033[1;33m%-32s\033[0m \033[1m%-30s\033[0m \033[2m%s\033[0m\n", chord, action, desc
        has_rows++
      }
    }
    END {
      printf "\n"
    }
  ' "$KEYS_FILE")

  if [[ -z ${output//[[:space:]]/} ]]; then
    echo "No keybindings matched: '$filter'"
    echo "Run 'apex keys' without filters to see all keybindings."
    return 0
  fi

  if [[ -t 1 ]] && command -v less >/dev/null 2>&1 && (( $(echo "$output" | wc -l) > $(tput lines 2>/dev/null || echo 24) )); then
    echo "$output" | less -FRX
  else
    echo "$output"
  fi
}

case "${1:-}" in
  --help|-h)
    usage
    exit 0
    ;;
  --menu|-m)
    shift
    show_menu "$@"
    ;;
  --raw|-r)
    show_raw
    ;;
  *)
    display_cheat_sheet "${1:-}"
    ;;
esac
