#!/bin/bash

# apex:summary=Reinstall Apex packages and reset default configs
# apex:requires-sudo=true

set -e

echo -e "This will reinstall all default Apex packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  apex-reinstall-pkgs
  apex-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && apex-system-reboot
fi
