#!/bin/bash

# apex:summary=Take a screenshot
# apex:group=capture
# apex:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# apex:examples=apex screenshot | apex capture screenshot region
# apex:aliases=apex screenshot

if [[ -n ${APEX_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$APEX_SCREENSHOT_DIR"
fi

omasnap_args=()
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
