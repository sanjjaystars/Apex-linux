#!/bin/bash

# apex:summary=Remove the GeForce NOW Flatpak app and its data.
# apex:group=remove
# apex:name=gaming geforce-now

set -e

if apex-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
