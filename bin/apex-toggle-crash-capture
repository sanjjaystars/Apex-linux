#!/bin/bash

# apex:summary=Toggle crash capture notifications

# nf-md-robot_dead, escaped so this file reads without a Nerd Font.
readonly CRASH_GLYPH=$'\U000f16a1'

apex-toggle crash-capture-off

# The unit checks the same flag with ConditionPathExists, so stopping and
# starting only settles this session; the next login reads the flag itself.
if apex-toggle-enabled crash-capture-off; then
  systemctl --user stop apex-crash-watch.service
  apex-notification-send -g "$CRASH_GLYPH" "Crash capture disabled"
else
  systemctl --user start apex-crash-watch.service
  apex-notification-send -g "$CRASH_GLYPH" "Crash capture enabled"
fi
