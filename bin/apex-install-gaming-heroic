#!/bin/bash

# apex:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# apex:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
apex-pkg-add heroic-games-launcher-bin
apex-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
