#!/bin/bash

# apex:summary=Launch a floating terminal with the Apex presentation wrapper
# apex:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source apex-restart-gum

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else gets the Done/Failed prompt.
presentation_script="apex-show-logo; $cmd; code=\$?; if (( code != 130 )); then apex-show-done \$code; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.apex.terminal --title=Apex -e bash -c "$presentation_script"
