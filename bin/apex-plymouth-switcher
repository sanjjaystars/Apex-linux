#!/bin/bash

# apex:summary=Open the Plymouth unlock screen switcher

preview_dir="${XDG_CACHE_HOME:-$HOME/.cache}/apex/unlock-selector/previews"

rm -rf "$preview_dir"
mkdir -p "$preview_dir"

ln -s "$APEX_PATH/default/plymouth/preview-unlock.png" "$preview_dir/default.png"

apex-plymouth-list | while read -r name; do
  ln -s "$(apex-theme-dir "$name")/preview-unlock.png" "$preview_dir/$name.png" 2>/dev/null
done

current=$(apex-plymouth-current)
selected=""
[[ -n $current && -e $preview_dir/$current.png ]] && selected="$preview_dir/$current.png"

exec apex-menu-images --print-name --show-labels --selected "$selected" "$preview_dir"
