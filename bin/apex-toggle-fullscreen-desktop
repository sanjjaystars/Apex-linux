#!/bin/bash

# apex:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# apex:args=[toggle|on|off]
# apex:examples=apex toggle fullscreen desktop | apex toggle fullscreen desktop off | apex toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if apex-toggle-enabled bar-off && apex-hyprland-toggle-enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: apex-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

apex-toggle-bar "$ACTION"
apex-hyprland-toggle window-no-gaps "$ACTION"
