#!/bin/bash

# apex:summary=List available themes
# apex:examples=apex theme list | apex theme set "Tokyo Night"

set -euo pipefail

APEX_PATH="${APEX_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

list_themes() {
  local dir
  for base in "$HOME/.config/apex/themes" "$APEX_PATH/themes"; do
    if [[ -d "$base" ]]; then
      for dir in "$base"/*; do
        if [[ -d "$dir" ]]; then
          basename "$dir"
        fi
      done
    fi
  done
}

list_themes | sort -u | awk -F'-' '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2); print}' OFS=' '
