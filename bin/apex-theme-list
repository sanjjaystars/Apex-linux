#!/bin/bash

# apex:summary=List available themes
# apex:examples=apex theme list | apex theme set "Tokyo Night"

{
  find ~/.config/apex/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$APEX_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
