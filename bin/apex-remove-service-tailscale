#!/bin/bash

# apex:summary=Remove Tailscale and its bar plugin.
# apex:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now apex-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
apex-plugin-disable apex.tailscale
apex-webapp-remove "Tailscale" 2>/dev/null || true
apex-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
