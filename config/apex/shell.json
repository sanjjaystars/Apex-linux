{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "apex.clock",
    "layout": {
      "left": [
        {
          "id": "apex.menu"
        },
        {
          "id": "apex.workspaces"
        }
      ],
      "center": [
        {
          "id": "apex.indicators"
        },
        {
          "id": "apex.elsewhen"
        },
        {
          "id": "apex.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "apex.keyboard-layout"
        },
        {
          "id": "apex.weather"
        },
        {
          "id": "apex.system-update"
        }
      ],
      "right": [
        {
          "id": "apex.tray"
        },
        {
          "id": "apex.agents"
        },
        {
          "id": "apex.bluetooth"
        },
        {
          "id": "apex.network"
        },
        {
          "id": "apex.audio"
        },
        {
          "id": "apex.monitor"
        },
        {
          "id": "apex.power"
        }
      ]
    }
  },
  "plugins": []
}
